{
  "name": "moor",
  "version": "0.53.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun run --hot apps/api/index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "build": "cd apps/web && bun run build",
    "start": "bun run apps/api/index.ts",
    "test": "bun test",
    "lint": "bunx biome check .",
    "typecheck": "bunx tsc --noEmit -p apps/api/tsconfig.json && (cd apps/web && bunx tsc -b) && bunx tsc --noEmit -p packages/contract/tsconfig.json && bunx tsc --noEmit -p packages/cli/tsconfig.json && bunx tsc --noEmit -p packages/mcp/tsconfig.json",
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint:fix": "bunx biome check --write .",
    "format": "bunx biome format --write .",
    "prepare": "bunx lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "lefthook": "^2.1.2",
    "semantic-release": "^25.0.3",
    "semantic-release-ai-notes": "^0.2.3",
    "semantic-release-monorepo": "^8.0.2",
    "semantic-release-plugin-decorators": "^4.0.0",
    "zod": "^4.3.6"
  }
}
