{
  "name": "moor",
  "version": "0.56.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun run --hot apps/api/index.ts",
    "dev:web": "vp dev",
    "build": "bun run --cwd apps/web typecheck && vp build",
    "start": "bun run apps/api/index.ts",
    "test": "bun test",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --workspaces --if-present typecheck",
    "check": "vp check && bun run typecheck && bun run test",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "prepare": "test ! -d node_modules/vite-plus || vp config --no-agent"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "@types/bun": "latest",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.3.6"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.12",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  }
}
